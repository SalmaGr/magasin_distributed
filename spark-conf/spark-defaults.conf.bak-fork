# ============================================================
#  SPARK CONFIGURATION — Smart Library Lakehouse (Apache Iceberg)
#  À placer dans spark-conf/spark-defaults.conf
# ============================================================

# ── Packages Iceberg + Kafka (téléchargés automatiquement) ───
spark.jars.packages=org.apache.iceberg:iceberg-spark-runtime-3.4_2.12:1.5.2,\
org.apache.iceberg:iceberg-aws-bundle:1.5.2,\
org.apache.spark:spark-sql-kafka-0-10_2.12:3.4.0,\
org.apache.hadoop:hadoop-aws:3.3.4,\
com.amazonaws:aws-java-sdk-bundle:1.12.262

# ── Extensions Iceberg ────────────────────────────────────────
spark.sql.extensions=org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions

# ── Catalogue REST Iceberg (Lakekeeper) ───────────────────────
spark.sql.catalog.lakehouse=org.apache.iceberg.spark.SparkCatalog
spark.sql.catalog.lakehouse.type=rest
spark.sql.catalog.lakehouse.uri=http://lakekeeper:8181/catalog
spark.sql.catalog.lakehouse.warehouse=lakehouse
spark.sql.catalog.lakehouse.io-impl=org.apache.iceberg.aws.s3.S3FileIO
spark.sql.catalog.lakehouse.s3.endpoint=http://minio:9000
spark.sql.catalog.lakehouse.s3.access-key-id=minioadmin
spark.sql.catalog.lakehouse.s3.secret-access-key=minioadmin123
spark.sql.catalog.lakehouse.s3.path-style-access=true
spark.sql.defaultCatalog=lakehouse

# ── Connexion MinIO (S3-compatible, pour sources brutes CSV/JSON/XML) ──
spark.hadoop.fs.s3a.endpoint=http://minio:9000
spark.hadoop.fs.s3a.access.key=minioadmin
spark.hadoop.fs.s3a.secret.key=minioadmin123
spark.hadoop.fs.s3a.path.style.access=true
spark.hadoop.fs.s3a.impl=org.apache.hadoop.fs.s3a.S3AFileSystem
spark.hadoop.fs.s3a.connection.ssl.enabled=false
spark.hadoop.fs.s3a.aws.credentials.provider=org.apache.hadoop.fs.s3a.SimpleAWSCredentialsProvider

# ── Sérialisation Kryo (performances) ────────────────────────
spark.serializer=org.apache.spark.serializer.KryoSerializer

# ── Mémoire et parallélisme ───────────────────────────────────
spark.driver.memory=2g
spark.executor.memory=2g
spark.sql.shuffle.partitions=8
spark.default.parallelism=8

# ── Logs (réduire le bruit) ───────────────────────────────────
spark.ui.showConsoleProgress=true

# ============================================================
#  MODE DISTRIBUÉ — cluster Spark standalone (docker-compose.yml)
# ============================================================
spark.master=spark://spark-master:7077
spark.driver.host=jupyter
spark.driver.bindAddress=0.0.0.0
spark.driver.port=7078
spark.blockManager.port=7079
# 3 workers x 2 cœurs : un exécuteur de 2 cœurs / 2 Go par worker
spark.executor.cores=2
spark.executor.memory=2g
spark.cores.max=6
spark.sql.shuffle.partitions=24
spark.default.parallelism=24
spark.sql.adaptive.enabled=true
spark.sql.files.maxPartitionBytes=134217728
